{
  "name": "ai-finance",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": "22.x" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "pnpm --filter @repo/web e2e",
    "protocols:conform": "pnpm --filter @repo/protocols conform"
  },
  "pnpm": {
    "overrides": {
      "zod": "3.25.76"
    }
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "prettier": "^3.5.0"
  }
}
