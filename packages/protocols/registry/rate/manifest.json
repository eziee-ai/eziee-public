  "actions": {
    "placeOrder": {
      "title": "Place limit order",
      "spends": true,
      "calls": [
        {
          "contract": "matchingEngine",
          "abi": "function limitBuy((address base, address quote, uint256 price, uint256 amount, bool isMaker, uint32 n, address recipient) params)",
          "spend": [
            {
              "token": {
                "arg": "params.quote"
              },
              "amount": {
                "arg": "params.amount"
              }
            }
          ],
          "receive": {
            "token": {
              "arg": "params.base"
            }
          },
          "recipient": {
            "arg": "params.recipient"
          }
        },
        {
          "contract": "matchingEngine",
          "abi": "function limitSell((address base, address quote, uint256 price, uint256 amount, bool isMaker, uint32 n, address recipient) params)",
          "spend": [
            {
              "token": {
                "arg": "params.base"
              },
              "amount": {
                "arg": "params.amount"
              }
            }
          ],
          "receive": {
            "token": {
              "arg": "params.quote"
            }
          },
          "recipient": {
            "arg": "params.recipient"
          }
        }
      ]
    },
    "swap": {
      "title": "Swap",
      "spends": true,
      "calls": [
        {
          "contract": "matchingEngine",
          "abi": "function marketBuy((address base, address quote, uint256 amount, bool isMaker, uint32 n, address recipient, uint32 slippageLimit) input)",
          "spend": [
            {
              "token": {
                "arg": "input.quote"
              },
              "amount": {
                "arg": "input.amount"
              }
            }
          ],
          "receive": {
            "token": {
              "arg": "input.base"
            }
          },
          "recipient": {
            "arg": "input.recipient"
          }
        },
        {
          "contract": "matchingEngine",
          "abi": "function marketSell((address base, address quote, uint256 amount, bool isMaker, uint32 n, address recipient, uint32 slippageLimit) input)",
          "spend": [
            {
              "token": {
                "arg": "input.base"
              },
              "amount": {
                "arg": "input.amount"
              }
            }
          ],
          "receive": {
            "token": {
              "arg": "input.quote"
            }
          },
          "recipient": {
            "arg": "input.recipient"
          }
        }
      ],
      "alwaysAsk": true
    },
    "cancelOrder": {
      "title": "Cancel order",
      "spends": false,
      "calls": [
        {
          "contract": "matchingEngine",
          "abi": "function cancelOrder(address base, address quote, bool isBid, uint32 orderId)",
          "ignore": [
            {
              "arg": "base",
              "reason": "Names the order book the order rests in. It receives nothing: a cancelled order's escrow returns to the order's owner."
            },
            {
              "arg": "quote",
              "reason": "Names the order book the order rests in. It receives nothing: a cancelled order's escrow returns to the order's owner."
            }
          ]
        }
      ]
    },
    "removeLiquidity": {
      "title": "Remove liquidity",
      "spends": false,
      "calls": [
        {
          "contract": "positionManager",
          "abi": "function decreaseLiquidity(uint256 tokenId, uint16 bps, uint256 minBase, uint256 minQuote, address recipient, uint256 deadline)",
          "recipient": {
            "arg": "recipient"
          }
        }
      ],
      "alwaysAsk": true
    },
    "collectFees": {
      "title": "Collect fees",
      "spends": false,
      "calls": [
        {
          "contract": "positionManager",
          "abi": "function collect(uint256 tokenId, address recipient)",
          "recipient": {
            "arg": "recipient"
          }
        }
      ]
    }
  }
